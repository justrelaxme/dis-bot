# /metrics закрыт от внешнего мира: раскрывает внутренние счётчики и не должен
# быть публичным — скрейпинг идёт изнутри сети контейнеров.
{$BOT_DOMAIN} {
	# Живой поток витрины не сжимаем: gzip копит байты до заполнения блока, и события
	# приходили бы пачками с опозданием, а не сразу.
	@compressible not path /api/live/*
	encode @compressible gzip

	@metrics path /metrics
	respond @metrics 404

	reverse_proxy bot:3000
}
