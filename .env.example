NODE_ENV=development
LOG_LEVEL=debug

# Discord Developer Portal → Bot → Token
DISCORD_TOKEN=
# Discord Developer Portal → General Information → Application ID
DISCORD_APP_ID=
# ID сервера: правый клик по серверу → Copy Server ID (нужен режим разработчика)
DISCORD_GUILD_ID=

# Пароль сервиса postgres в docker-compose (POSTGRES_PASSWORD там же). Тем же
# значением docker-compose переопределяет DATABASE_URL для контейнеров migrate и
# bot — значение ниже, с localhost, эти переопределения не трогает.
POSTGRES_PASSWORD=

# Значения ниже — для локальной разработки (npm run dev на хосте). Порты 55432 и
# 56379 — это те, что пробрасывает `npm run test:services:up`; отдельного Postgres
# на 5432 проект не поднимает. База disbot_dev создаётся один раз вручную, чтобы
# прогон тестов (он чистит таблицы в disbot_test) не сносил данные разработки:
#   podman exec disbot-test-pg createdb -U bot disbot_dev
# Внутри docker-compose для контейнеров migrate и bot те же переменные
# переопределены на service-имена postgres/redis (см. docker-compose.yml) —
# правки здесь их не касаются.
DATABASE_URL=postgres://bot:bot@localhost:55432/disbot_dev
REDIS_URL=redis://localhost:56379

HTTP_PORT=3000
# Публичный HTTPS-адрес бота. Нужен для OAuth-колбэков на этапе 1.
PUBLIC_BASE_URL=https://bot.example.com

# Домен бота: читает сервис caddy в docker-compose и сам получает под него TLS
# Let's Encrypt. Не нужен для локальной разработки без caddy.
BOT_DOMAIN=

# Оба ключа необязательны: бот стартует и без них, только соответствующие команды
# отвечают понятным текстом вместо работы.
#
# STEAM_API_KEY — https://steamcommunity.com/dev/apikey
# Без него /link steam не сможет получить имя профиля и упадёт на этом шаге. Ранг
# Dota при этом продолжит обновляться: он приходит из OpenDota, а ей ключ не нужен.
STEAM_API_KEY=

# Бэкап базы. Включён по умолчанию: потеря Postgres — это безвозвратная потеря
# уровней, монет, достижений и всей турнирной летописи. Привязки и ранги подтянутся
# заново из API игр, история — нет.
#
# Отказ бэкапа бота не роняет, а пишет ошибку в лог. Восстановление:
#   gunzip -c backups/disbot-2026-07-30-0400.sql.gz | psql "$DATABASE_URL"
# Метрики Prometheus на /metrics. Выключены по умолчанию: они раскрывают имена
# команд, число ошибок и имена провайдеров — карту того, что внутри и где болит.
# Включайте только если наружу этот путь закрыт (в docker-compose это делает Caddy).
METRICS_ENABLED=false

# Применять миграции при старте бота. Нужно там, где контейнер один и отдельного шага
# миграций нет. В docker-compose миграции делает отдельный сервис, и повторный прогон
# здесь — пустая операция.
MIGRATE_ON_START=true

BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=7
# В 4 утра — когда на игровом сервере тише всего.
BACKUP_CRON=0 4 * * *

# RIOT_API_KEY — https://developer.riotgames.com
# Без него /link riot и синхронизация рангов LoL и TFT не работают. /link valorant
# работает независимо: там ранг вводится руками, без обращения к API.
# Продакшн-ключ выдаётся по заявке с ревью, ключ разработчика живёт 24 часа.
RIOT_API_KEY=

# Регистрировать slash-команды при старте бота. По умолчанию true — иначе новый набор
# команд требует отдельного шага `npm run deploy-commands`, а он запускается через tsx,
# которого при установке без dev-зависимостей на сервере нет. Тогда бот поднимается и
# работает, а команды в Discord остаются прошлыми, и понять это по логам нельзя.
# false — если команды ставятся отдельным шагом и лишний запрос при перезапуске не нужен.
DEPLOY_COMMANDS_ON_START=true

# HOYOLAB_COOKIE — строка Cookie аккаунта HoYoLAB, целиком, как её отдаёт браузер.
# Единственный способ прочитать полный состав аккаунта Genshin: публичного API у
# HoYoverse нет, а внутренний без авторизации не отвечает. Нужен для драфта персонажей —
# без неё бот не знает, у кого какой персонаж есть, и пометок в драфте не будет.
#
# Ключ здесь ТВОЙ, а не игроков: cookie нужны только чтобы запрос приняли, данные при
# этом отдаются про любой UID с публичной Летописью. Игроку остаётся один тумблер:
# HoYoLAB → Летопись → шестерёнка → сделать публичной.
#
# Где взять: hoyolab.com, войти, F12 → Application → Cookies → скопировать значения
# ltoken_v2 и ltuid_v2 в виде "ltoken_v2=...; ltuid_v2=...". Сгорают при смене пароля.
# Читаются только зарубежные UID (на 6, 7, 8, 9): у китайских серверов отдельный API.
HOYOLAB_COOKIE=
